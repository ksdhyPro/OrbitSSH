{
  "name": "orbitssh",
  "version": "1.10.16",
  "description": "SSH client",
  "main": "dist-electron/main/bootstrap.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.cjs",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node scripts/generate-build-info.cjs",
    "test": "tsc -p tsconfig.electron.json && node --test --experimental-test-module-mocks tests/ai/*.test.mjs tests/mcp/*.test.mjs tests/sftp/*.test.mjs tests/main/*.test.mjs tests/ssh/*.test.mjs tests/installer/*.test.mjs && vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tests/renderer/tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:ai": "tsc -p tsconfig.electron.json && node --test --experimental-test-module-mocks tests/ai/*.test.mjs",
    "test:mcp": "tsc -p tsconfig.electron.json && node --test tests/mcp/*.test.mjs",
    "mcp:stdio": "node dist-electron/mcp/standalone.js",
    "test:renderer": "vitest run",
    "test:sftp": "tsc -p tsconfig.electron.json && node --test tests/sftp/*.test.mjs",
    "test:release": "node --test tests/publishing/gitee-release.test.cjs",
    "version:sync": "node scripts/sync-version-from-update.cjs",
    "release:gitee": "node scripts/publish-gitee-release.cjs",
    "release:gitee:upload": "node scripts/publish-gitee-release.cjs --upload-only",
    "prepackage": "npm run version:sync",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ node scripts/build-windows-installer.cjs",
    "dist-mac": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac"
  },
  "build": {
    "appId": "com.orbitssh.app",
    "productName": "OrbitSSH",
    "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/logo.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".agents/skills/orbitssh-mcp",
        "to": "skills/orbitssh-mcp"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OrbitSSH",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "packaging/windows/assets/header.bmp",
      "installerSidebar": "packaging/windows/assets/sidebar.bmp",
      "uninstallerSidebar": "packaging/windows/assets/sidebar.bmp",
      "license": "LICENSE",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://1ms.ink/update/"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.11",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.4",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "vue": "^3.5.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.16.5",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sharp": "^0.35.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12",
    "wait-on": "^8.0.3"
  }
}
